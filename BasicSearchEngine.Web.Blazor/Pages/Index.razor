@page "/"
@using System.Net.Http.Json
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JSRuntime

<div id="particles-js"></div>

<div class="search-dashboard container-fluid @(isCompareMode ? "compare-active-bg" : "")">
    <div>
        <h2 class="title-docs-page">Search</h2>
    </div>

    <div class="filter-panel shadow-sm">
        <div class="row mb-4">
            <div class="col-12">
                @* <label class="form-label small fw-bold text-uppercase tracking-wider">Query</label> *@
                <div class="input-group input-group-lg search-input-group">
                    <input @bind="query" @bind:event="oninput" @onkeyup="HandleKeyUp" class="form-control" disabled="@isCompareMode"
                        placeholder="Enter query..." />
                    <button class="btn btn-success btn-search fw-bold btn-lg" disabled="@isCompareMode" @onclick="() => PerformSearch(1)">
                        <i class="bi bi-lightning-charge-fill me-2"></i> Search
                    </button>
                    <button class="btn btn-pagination btn-outline-secondary" @onclick="ToggleSettings" title="Advanced settings">
                        <i class="bi @(isSettingsExpanded ? "bi-chevron-up" : "bi-gear-fill")"></i>
                        @* @(isSettingsExpanded ? " Hide settings" : " Filters") *@
                    </button>
                </div>
            </div>
        </div>

        <div class="settings-panel @(isSettingsExpanded ? "expanded" : "collapsed")">
            <div class="search-settings-container p-3 border rounded bg-light shadow-sm mb-4 @(isCompareMode ? "compare-locked" : "")">
                <div class="row">
                    <div class="col-md-6 border-end">
                        <div class="form-control-group-dropdowns mb-4">
                            <div>
                                <h3 class="title-bm25 text-secondary mb-3"><i class="bi bi-sliders2 me-1"></i>Algoritm & Mod</h3>
                            </div>
                        
                            <div class="filter-item mb-3">
                                <label class="form-label small fw-bold text-uppercase text-muted">Preprocessing Mode</label>
                                <select class="form-select form-select-sm" 
                                        value="@selectedMode" 
                                        disabled="@isCompareMode"
                                        @onchange="@(async (e) => { selectedMode = e.Value?.ToString() ?? "custom"; await SaveSetting(RankingKey, selectedMode); })">
                                    <option value="custom">Edu (Regex)</option>
                                    <option value="nltk">NLTK Strategy</option>
                                    <option value="spacy">SpaCy Strategy</option>
                                    <option value="sklearn">Sklearn Strategy</option>
                                </select>
                            </div>

                            <div class="filter-item mb-3">
                                <label class="form-label small fw-bold text-uppercase text-muted">Ranking Algorithm</label>
                                <select class="form-select form-select-sm" 
                                        value="@selectedRanking" 
                                        disabled="@isCompareMode"
                                        @onchange="@(async (e) => { selectedRanking = e.Value?.ToString() ?? "bm25"; await SaveSetting(RankingKey, selectedRanking); })">
                                    <option value="bm25">BM25 Ranking</option>
                                    <option value="cosine">TF-IDF & Cosine</option>
                                    <option value="jaccard">TF-IDF & Jaccard</option>
                                </select>
                            </div>
                        </div>

                        @* Panoul de parametri BM25 integrat în coloana 1 *@
                        @if (selectedRanking == "bm25")
                        {
                            <div class="bm25-control-panel p-2 border rounded bg-white animate-fade-in">
                                <div>
                                    <h3 id="title-bm25"><i class="bi bi-gear-fill me-1"></i>BM25 Params</h3>
                                </div>
                                <div class="param-input-group d-flex align-items-center gap-2 mb-2">
                                    <div class="flex-grow-1">
                                        <label id="bm25-k1-label" class="small text-muted">K1</label>
                                        <input type="number" step="0.1" 
                                            value="@bm25K1" 
                                            class="form-control form-control-bm25 form-control-sm" 
                                            disabled="@isCompareMode"
                                            @oninput="@(async (e) => { if(double.TryParse(e.Value?.ToString(), out var val)) { bm25K1 = Math.Round(val, 1); await SaveSetting(K1Key, e.Value.ToString()); } })" />
                                    </div>
                                    <span class="bm25-badge bg-primary mt-3" style="min-width: 40px;">[1.2 - 2.0]</span>
                                </div>

                                <div class="param-input-group d-flex align-items-center gap-2 mb-2">
                                    <div class="flex-grow-1">
                                        <label id="bm25-b-label" class="small text-muted">B</label>
                                        <input type="number" step="0.05" 
                                            value="@bm25B" 
                                            class="form-control form-control-bm25 form-control-sm" 
                                            disabled="@isCompareMode" 
                                            @oninput="@(async (e) => { if(double.TryParse(e.Value?.ToString(), out var val)) { bm25B = Math.Round(val, 2); await SaveSetting(BKey, e.Value.ToString()); } })" />
                                    </div>
                                    <span class="bm25-badge bg-primary mt-3" style="min-width: 40px;">[0 - 1], ideal 0.75</span>
                                </div>

                                <div id="btn-apply-container" class="d-flex align-items-end">
                                    <button class="btn btn-sm btn-primary btn-apply align-self-end"
                                        @onclick="() => PerformSearch(1)" title="Update parameters to BM25 Algorithm" disabled="@isCompareMode">
                                        <i class="bi bi-check-circle-fill me-2"></i> Apply
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-md-6 ps-4">
                        <div>
                            <h3 class="title-bm25 text-secondary mb-3"><i class="bi bi-gear-fill me-1"></i>Multi-term search</h3>
                        </div>                    
                        <div class="search-logic-group d-flex flex-column gap-3">
                            <div class="form-check custom-radio-indigo">
                                <input class="form-check-input bm25-form-check-input" type="radio" name="searchLogic" id="logicOr" 
                                    checked="@(searchLogic == "OR")"
                                    disabled="@isCompareMode" 
                                    @onchange="@(async (e) => { searchLogic = "OR"; await SaveSetting(LogicKey, "OR"); })" />
                                <label class="form-check-label" for="logicOr">
                                    <strong>OR</strong> - Cel puțin un cuvânt prezent
                                </label>
                            </div>

                            <div class="form-check custom-radio-indigo">
                                <input class="form-check-input" type="radio" name="searchLogic" id="logicAnd" 
                                    checked="@(searchLogic == "AND")" 
                                    disabled="@isCompareMode" 
                                    @onchange="@(async (e) => { searchLogic = "AND"; await SaveSetting(LogicKey, "AND"); })" />
                                <label class="form-check-label" for="logicAnd">
                                    <strong>AND</strong> - Toate cuvintele prezente
                                </label>
                            </div>

                            <div class="form-check custom-radio-indigo">
                                <input class="form-check-input" type="radio" name="searchLogic" id="logicHybrid" 
                                    checked="@(searchLogic == "HYBRID")"
                                    disabled="@isCompareMode"
                                    @onchange="@(async (e) => { searchLogic = "HYBRID"; await SaveSetting(LogicKey, "HYBRID"); })" />
                                <label class="form-check-label" for="logicHybrid">
                                    <strong>Hibrid</strong> - Prioritizează potrivirile multiple
                                </label>
                            </div>
                        </div>

                        @if (query.Trim().Contains(" "))
                        {
                            <div class="mt-4 p-2 rounded bg-indigo-light text-indigo border border-indigo animate-fade-in">
                                <i class="bi bi-intersect me-2"></i>
                                <strong>Combined Search Active:</strong> Folosind logica <u>@searchLogic</u> pentru termenii detectați.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12 d-flex gap-5">
                    <div class="legend-item">
                        <div class="legend-square square-bm25"></div>
                        <span class="text-muted">BM25 similarity</span>
                    </div>
                    <div class="legend-item">
                        <div class="legend-square square-cosine"></div>
                        <span class="text-muted">Cosine similarity</span>
                    </div>
                    <div class="legend-item">
                        <div class="legend-square square-jaccard"></div>
                        <span class="text-muted">Jaccard similarity</span>
                    </div>
                    <div class="legend-item">
                        <div class="legend-square square-combined"></div>
                        <span class="text-muted">Combined search</span>
                    </div>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-12 d-flex gap-2 extra-buttons-container">
                    @* Butonul Compare - se dezactivează dacă deja suntem în compare mode *@
                    <button class="btn btn-compare shadow-sm" 
                            @onclick="ExecuteCompareSearch"
                            disabled="@isCompareMode"
                            title="Compare all 3 methods. Ranking is based on BM25.">
                        <i class="bi bi-columns-gap me-2"></i> Compare Metrics
                    </button>

                    @* Butonul Reset - vizibil mereu sau doar în compare mode *@
                    <button class="btn btn-reset shadow-sm" @onclick="ResetToDefault">
                        <i class="bi bi-arrow-counterclockwise me-2"></i> Reset
                    </button>
                </div>
            </div>
        </div>

    </div>

    @* Secțiunea de rezultate și paginare rămâne neschimbată *@
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 text-muted">Scanning Library...</p>
        </div>
    }
    else if (searchResponse?.results?.Count > 0)
    {
        <div class="results-container">
            <div class="container-cron d-flex justify-content-between align-items-center mb-3">
                <p id="show-results-text" class="text-muted small m-0">
                    Showing @searchResponse.results.Count of @searchResponse.total results
                </p>
                <span id="cron" class="badge bg-light text-dark border shadow-sm p-2">
                    <i class="bi bi-stopwatch me-1 text-primary"></i> 
                    <strong>@searchResponse.execution_time_ms ms</strong>
                </span>
                @* Butonul de Toggle pentru Sortare *@
                <div class="sort-controls">
                    <button class="sort-toggle-btn @(currentSortOrder == "asc" ? "sort-active-asc" : "")" 
                            @onclick="ToggleSortOrder" 
                            title="Schimbă ordinea sortării după scor">
                        @if (currentSortOrder == "desc")
                        {
                            <i class="bi bi-sort-numeric-down-alt"></i>
                            <span>Score</span>
                        }
                        else
                        {
                            <i class="bi bi-sort-numeric-up"></i>
                            <span>Score</span>
                        }
                    </button>
                </div>
            </div>
            @* <p class="text-muted small">Showing @searchResponse.results.Count of @searchResponse.total results</p> *@
            @foreach (var r in searchResponse.results)
            {
                // Identificăm dacă este primul rezultat de pe prima pagină
                bool isBest = (searchResponse.results.IndexOf(r) == 0 && currentPage == 1);

                <div class="card result-card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h4 class="card-title text-primary fw-bold">
                                <a href="/documents?id=@r.doc_id" class="text-decoration-none text-primary">
                                    @r.title 
                                    @if (isBest)
                                    {
                                        <i class="bi bi-star-fill star-card-title ms-1"></i>
                                    }
                                </a>
                            </h4>
                            <div class="d-flex flex-wrap gap-2 mt-2 mb-3">
                                @if (isCompareMode)
                                {
                                    <span class="metric-badge badge-bm25 shadow-sm p-2">@(r.bm25_score?.ToString("F4") ?? "0.0000")</span>
                                    <span class="metric-badge badge-cosine shadow-sm p-2">@(r.cosine_score?.ToString("F4") ?? "0.0000")</span>
                                    <span class="metric-badge badge-jaccard shadow-sm p-2">@(r.jaccard_score?.ToString("F4") ?? "0.0000")</span>
                                }
                                else
                                {
                                    <span class="metric-badge @GetBadgeClass()">
                                        @r.score.ToString("F4")
                                    </span>
                                    @if (query.Trim().Contains(" "))
                                    {
                                        <span class="metric-badge bg-indigo p-2 shadow-sm animate-fade-in" 
                                            title="Logica @searchLogic: @r.matches termeni găsiți">
                                            <i class="bi bi-intersect me-1"></i> 
                                            @r.matches Match (@searchLogic)
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                        <p class="card-text text-secondary">@((MarkupString)HighlightSnippet(r.snippet))</p>
                    </div>
                </div>
            }
        </div>

        <div class="pagination-wrap mt-5 mb-5">
            <button class="btn btn-outline-secondary btn-pagination" disabled="@(currentPage == 1)"
                @onclick="() => PerformSearch(currentPage - 1)">&lt;&lt;</button>
            <div class="page-info fw-bold mx-3">Page @currentPage of @TotalPages</div>
            <button class="btn btn-outline-secondary btn-pagination" disabled="@(currentPage >= TotalPages)"
                @onclick="() => PerformSearch(currentPage + 1)">&gt;&gt;</button>
        </div>
    }
    else
    {
        <div class="card result-card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <h4 class="card-title text-primary fw-bold">No results</h4>
                </div>
                <p class="card-text text-secondary">Enter a valid query to search for.</p>
            </div>
        </div>
    }
</div>

@code {
    private string query = string.Empty;
    private string searchLogic = "OR";
    private string selectedMode = "custom";
    private string selectedRanking = "bm25";
    private string currentSortOrder = "desc"; // Implicitly descendent
    private double bm25K1 = 1.5;
    private double bm25B = 0.75;
    private bool isLoading = false;
    private bool isCompareMode = false;
    private bool isSettingsExpanded;
    private const string StorageKey = "searchSettingsExpanded";
    private const string SettingsExpandedKey = "search_settings_expanded";
    private const string RankingKey = "search_method";
    private const string ModeKey = "search_mode";
    private const string LogicKey = "search_logic";
    private const string K1Key = "search_bm25_k1";
    private const string BKey = "search_bm25_b";
    private bool hasSearched = false;
    private int currentPage = 1;
    private int pageSize = 5;
    private SearchResponseDto? searchResponse;

    private int TotalPages => searchResponse != null ? (int)Math.Ceiling((double)searchResponse.total / pageSize) : 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        @* if (firstRender)
        {
            // Citim starea salvată la prima încărcare a paginii
            var savedState = await JSRuntime.InvokeAsync<string>("localStorage.getItem", StorageKey);
            
            if (!string.IsNullOrEmpty(savedState))
            {
                isSettingsExpanded = bool.Parse(savedState);
                StateHasChanged(); // Forțăm re-randarea pentru că suntem în OnAfterRender
            }
        } *@

        if (firstRender)
        {
            // Această linie pornește fundalul abstract
            await JSRuntime.InvokeVoidAsync("initParticles");

            await LoadSettings();
            StateHasChanged();
        }
    }

    private async Task LoadSettings()
    {
        // 1. Starea panoului (Expand/Collapse)
        var expanded = await JSRuntime.InvokeAsync<string>("localStorage.getItem", SettingsExpandedKey);
        if (!string.IsNullOrEmpty(expanded)) isSettingsExpanded = bool.Parse(expanded);

        // 2. Metoda de Ranking (TF-IDF, BM25, etc.)
        var ranking = await JSRuntime.InvokeAsync<string>("localStorage.getItem", RankingKey);
        if (!string.IsNullOrEmpty(ranking)) selectedRanking = ranking;

        // 3. Modul (Custom, NLTK, Sklearn)
        var mode = await JSRuntime.InvokeAsync<string>("localStorage.getItem", ModeKey);
        if (!string.IsNullOrEmpty(mode)) selectedMode = mode;

        // 4. Logica Booleană (AND, OR, HYBRID)
        var logic = await JSRuntime.InvokeAsync<string>("localStorage.getItem", LogicKey);
        if (!string.IsNullOrEmpty(logic)) searchLogic = logic;

        // 5. Parametrii BM25
        var k1Value = await JSRuntime.InvokeAsync<string>("localStorage.getItem", K1Key);
        if (!string.IsNullOrEmpty(k1Value)) bm25K1 = Math.Round(float.Parse(k1Value), 1);

        var bValue = await JSRuntime.InvokeAsync<string>("localStorage.getItem", BKey);
        if (!string.IsNullOrEmpty(bValue)) bm25B = Math.Round(float.Parse(bValue), 2);
    }

    // Metodă pentru a salva orice schimbare
    private async Task SaveSetting(string key, string value)
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", key, value);
    }

    // Handler pentru toggle-ul panoului
    private async Task ToggleSettings()
    {
        isSettingsExpanded = !isSettingsExpanded;
        await SaveSetting(SettingsExpandedKey, isSettingsExpanded.ToString());
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await PerformSearch(1);
    }

    private async Task OnFilterChanged()
    {
        if (!string.IsNullOrWhiteSpace(query))
        {
            await PerformSearch(1);
        }
    }

    private async Task PerformSearch(int page)
    {
        if (string.IsNullOrWhiteSpace(query)) return;
        isLoading = true;
        hasSearched = true;
        currentPage = page;
        isCompareMode = false; // Resetăm modul de comparare la o nouă căutare standard

        var client = ClientFactory.CreateClient("SearchApi");
        
        // Selectăm ruta corectă în funcție de selecția utilizatorului
        string route = selectedRanking switch
        {
            "bm25" => $"search/bm25?k1={bm25K1}&b={bm25B}&logic={searchLogic}",
            "jaccard" => $"search/jaccard?logic={searchLogic}",
            _ => selectedMode == "sklearn" ? "search/sklearn" : $"search/tfidf?logic={searchLogic}"
        };

        // Construim URL-ul final cu parametrii comuni
        var url = $"{route}{(route.Contains("?") ? "&" : "?")}query={Uri.EscapeDataString(query)}&page={currentPage}&page_size={pageSize}&mode={selectedMode}&sort_order={currentSortOrder}";

        try
        {
            searchResponse = await client.GetFromJsonAsync<SearchResponseDto>(url);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search error: {ex.Message}");
            searchResponse = new SearchResponseDto { results = new() };
        }
        finally
        {
            isLoading = false;
        }
    }

    private string HighlightSnippet(string snippet)
    {
        if (string.IsNullOrWhiteSpace(query)) return snippet;
        var highlighted = snippet;
        var terms = query.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        foreach (var t in terms)
        {
            var safe = System.Text.RegularExpressions.Regex.Escape(t.Trim());
            highlighted = System.Text.RegularExpressions.Regex.Replace(
            highlighted, $@"\b{safe}\b", m => $"<mark>{m.Value}</mark>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        }
        return highlighted;
    }

    private string GetBadgeClass()
    {
        return selectedRanking switch
        {
            "cosine" => "badge-cosine",
            "bm25" => "badge-bm25",
            "jaccard" => "badge-jaccard",
            _ => "bg-secondary"
        };
    }

    private async Task OnModeChanged(ChangeEventArgs e)
    {
        selectedMode = e.Value?.ToString() ?? "custom";

        // Dacă există deja un text în bară, declanșăm recăutarea automat
        if (!string.IsNullOrWhiteSpace(query))
        {
            await PerformSearch(1);
        }
    }

    private async Task OnMetricChanged(ChangeEventArgs e)
    {
        selectedRanking = e.Value?.ToString() ?? "bm25";

        // Recăutăm automat cu noua metrică selectată
        if (!string.IsNullOrWhiteSpace(query))
        {
            await PerformSearch(1);
        }
    }

    private async Task ExecuteCompareSearch()
    {
        if (string.IsNullOrWhiteSpace(query)) return;
        
        isCompareMode = true;
        var client = ClientFactory.CreateClient("SearchApi");
        // Apelăm noul endpoint
        var response = await client.GetAsync($"search/compare?query={Uri.EscapeDataString(query)}&limit=10");
        
        if (response.IsSuccessStatusCode)
        {
            searchResponse = await response.Content.ReadFromJsonAsync<SearchResponseDto>();
            StateHasChanged();
        }
    }

    private async Task ToggleSortOrder()
    {
        // Change sort order
        currentSortOrder = (currentSortOrder == "desc") ? "asc" : "desc";
        
        // If we have already searched, perform search again with new sort order
        if (!string.IsNullOrWhiteSpace(query))
        {
            await PerformSearch(1);
        }
    }

    private void ResetToDefault()
    {
        // 1. Resetăm stările de mod
        isCompareMode = false;
        
        // 2. Resetăm valorile de căutare și parametri
        query = "";
        searchLogic = "OR";
        selectedRanking = "bm25";
        selectedMode = "custom";
        bm25K1 = 1.5;
        bm25B = 0.75;
        currentPage = 1;
        isSettingsExpanded = false;
        
        // 3. Resetăm rezultatele (golim lista)
        searchResponse = new SearchResponseDto { 
            results = new List<SearchResultDto>(),
            total = 0
        };
        
        // 4. Forțăm UI-ul să se actualizeze
        StateHasChanged();
    }

    private class SearchResponseDto
    {
        public int total { get; set; }
        public double execution_time_ms { get; set; }
        public List<SearchResultDto> results { get; set; } = new();
    }

    private class SearchResultDto
    {
        public int doc_id { get; set; }
        public string title { get; set; } = string.Empty;
        public string snippet { get; set; } = string.Empty;
        public string matches { get; set; } = "";
        public double score { get; set; } // BM25 implicit
        public double? bm25_score { get; set; }
        public double? cosine_score { get; set; }
        public double? jaccard_score { get; set; }
    }
}