@page "/"
@inject IHttpClientFactory ClientFactory

<h1>Search</h1>

<div class="search-bar">
    <input @bind="query" @bind:event="oninput" placeholder="Type your query..." />
    <select @bind="selectedMode" class="form-select" style="width: auto; display: inline-block;">
        <option value="custom">Educational (Custom)</option>
        <option value="pro">Professional (NLTK)</option>
        <option value="sklearn">Performance (Sklearn)</option>
    </select>
    <select @bind="selectedRanking" class="form-select" style="width: auto; display: inline-block;">
        <option value="cosine">Cosine (TF-IDF)</option>
        <option value="jaccard">Jaccard (Set Based)</option>
    </select>
    <button @onclick="() => PerformSearch(1)">Search</button>
</div>

@if (isLoading)
{
    <p>Searching...</p>
}
else if (searchResponse?.results?.Count > 0)
{
    <p class="meta">Found @searchResponse.total result(s) for <strong>@query</strong>.</p>
    @foreach (var r in searchResponse.results)
    {
        <div class="result">
            <h3>@r.title <span class="score">@r.score</span></h3>
            <p>@((MarkupString)HighlightSnippet(r.snippet))</p>
        </div>
    }

    <div class="pagination" style="margin-top: 20px;">
        <button disabled="@(currentPage == 1)" @onclick="() => PerformSearch(currentPage - 1)">Previous</button>
        <span style="margin: 0 15px;">Page @currentPage of @TotalPages</span>
        <button disabled="@(currentPage >= TotalPages)" @onclick="() => PerformSearch(currentPage + 1)">Next</button>
    </div>
}

@code {
    private string query = string.Empty;
    private string selectedMode = "custom"; // <select @bind="selectedMode">
    private string selectedRanking = "cosine"; // <select @bind="selectedRanking">
    private bool isLoading = false;
    private int currentPage = 1;
    private int pageSize = 10;
    private SearchResponseDto? searchResponse;

    private int TotalPages => searchResponse != null ? (int)Math.Ceiling((double)searchResponse.total / pageSize) : 0;

    private async Task PerformSearch(int page)
    {
        if (string.IsNullOrWhiteSpace(query)) return;

        isLoading = true;
        currentPage = page;
        var client = ClientFactory.CreateClient("SearchApi");
        var url =
        $"search?q={Uri.EscapeDataString(query)}&page={currentPage}&page_size={pageSize}&mode={selectedMode}&ranking={selectedRanking}";

        try
        {
            searchResponse = await client.GetFromJsonAsync<SearchResponseDto>(url);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string HighlightSnippet(string snippet)
    {
        if (string.IsNullOrWhiteSpace(query))
            return snippet;

        var highlighted = snippet;
        var terms = query.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        foreach (var t in terms)
        {
            var safe = System.Text.RegularExpressions.Regex.Escape(t.Trim());
            highlighted = System.Text.RegularExpressions.Regex.Replace(
            highlighted,
            safe,
            m => $"<mark>{m.Value}</mark>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
            );
        }
        return highlighted;
    }

    private class SearchResponseDto
    {
        public string query { get; set; } = string.Empty;
        public int total { get; set; }
        public List<SearchResultDto> results { get; set; } = new();
    }

    private class SearchResultDto
    {
        public int doc_id { get; set; }
        public string title { get; set; } = string.Empty;
        public double score { get; set; }
        public string snippet { get; set; } = string.Empty;
    }
}